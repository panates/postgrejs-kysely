{
  "name": "kysely-postgrejs",
  "description": "Kysely dialect for PostgreJS - run a Kysely query builder on PostgreJS's wire-protocol client",
  "version": "1.2.1",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "kysely": ">=0.29.0 <0.31.0",
    "postgrejs": ">=3.11.0 <4"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.2.0",
    "@panates/eslint-config-ts": "^2.2.1",
    "@panates/rman-preset": "^1.8.2",
    "@panates/tsconfig": "^2.1.7",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.13",
    "@swc/helpers": "^0.5.23",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "dpdm": "^4.3.0",
    "expect": "^30.5.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "kysely": "^0.29.6",
    "mocha": "^12.0.3",
    "pg": "^8.23.1",
    "postgrejs": "^3.12.1",
    "prettier": "^3.9.9",
    "rman": "^2.11.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig-build.json --noEmit",
    "test": "mocha",
    "precitest": "rman clean",
    "citest": "c8 mocha",
    "bench": "rman build && node --expose-gc benchmark/bench.mjs",
    "bench:report": "node benchmark/render-report.mjs",
    "prepare": "husky || true",
    "prepublishOnly": "node -e \"console.error('Publish from the build directory - run rman publish, which generates that manifest itself'); process.exit(1)\""
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/postgrejs-kysely.git"
  },
  "keywords": [
    "kysely",
    "kysely-dialect",
    "postgrejs",
    "postgresql",
    "postgres",
    "sql",
    "query-builder",
    "typescript",
    "wire-protocol",
    "no-native-bindings",
    "mikro-orm"
  ],
  "publishConfig": {
    "access": "public"
  }
}
